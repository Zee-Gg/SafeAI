# Prettier formatting rules for the whole repo (YAML format, so comments are allowed).
# prettier-plugin-tailwindcss sorts Tailwind classes into a standard order.
# It must stay LAST in "plugins". In M3 we add "tailwindStylesheet" pointing at our CSS.
singleQuote: true
semi: true
trailingComma: all
printWidth: 100
plugins:
  - prettier-plugin-tailwindcss
